# ==============================
# General Application Settings
# ==============================

# Where downloads are saved (relative from home or absolute path).
# Example: Downloads
H0MELAB_DOWNLOAD_PATH=Downloads

# Folder used for app data/cache/config (relative paths are resolved from home).
# Example: .h0melab-downloader
H0MELAB_INSTALL_FOLDER=.h0melab-downloader

# Debug logging
# 0 = off, 1 = on
H0MELAB_DEBUG_MODE=0

# Separate downloads into language subfolders (e.g. german-dub/, english-sub/)
# 0 = off, 1 = on
H0MELAB_LANG_SEPARATION=0

# Language of the web interface.
# Options: en | de
H0MELAB_UI_LANGUAGE=en

# Wrap movies in their own folder (e.g. "Movie (2024)/Movie (2024).mkv").
# 0 = save the file directly into the download path, 1 = use a folder
H0MELAB_MOVIE_FOLDER=1

# Never download or install dependencies on its own.
# By default the app fetches what it needs at startup/on demand: the patchright
# Chromium, portable mpv/ffmpeg/Syncplay builds, and on headless Linux it even
# runs "sudo apt-get install xvfb" (which is why you may get a sudo password
# prompt on a server). Turn this on to disable all of that - already installed
# binaries are still found and used, missing ones just log a warning.
# 0 = off (auto-install), 1 = on (never install anything)
H0MELAB_NO_AUTO_INSTALL=0


# ==============================
# Anime & Language Preferences
# ==============================

# Disable English Sub downloads entirely
# 0 = off, 1 = on
H0MELAB_DISABLE_ENGLISH_SUB=0

# Preferred audio/sub language preset.
# Options: German Dub | English Sub | German Sub | English Dub
H0MELAB_LANGUAGE="German Dub"

# Output file naming template.
# Common placeholders: {title} {year} {imdbid} {season} {episode} {resolution} {language}
# {resolution} is read from the finished file (e.g. 720p), or `unknown` unless
# the container has exactly one video stream.
# Example filename template: `{title}.S{season}E{episode}.{resolution}.{language}.mp4`
# Example: groups by show + year, then season, then uses SxxExx naming
# (e.g. `Highschool DxD (2012) [imdbid-tt1759761]/Season 1/Highschool DxD S01E01.mkv`).
H0MELAB_NAMING_TEMPLATE="{title} ({year}) [imdbid-{imdbid}]/Season {season}/{title} S{season}E{episode}.mkv"


# MangaFire download format.
# Options: jpg (loose images) | cbz (one archive per chapter)
MANGAFIRE_FORMAT=jpg


# ==============================
# Provider & Streaming Options
# ==============================

# Streaming provider to use.
# Look at SUPPORTED_PROVIDERS in config.py for options.
H0MELAB_PROVIDER=VOE

# Provider fallback order used after the selected provider fails.
# The selected provider is always tried first, then the remaining providers follow this order.
H0MELAB_PROVIDER_FALLBACK_ORDER=VOE,Vidmoly,Vidoza,Doodstream

# How many HLS segments to fetch at once (Moflix keeps its existing fast path).
# Higher is faster until the host starts refusing connections; 1 disables it.
H0MELAB_HLS_CONCURRENCY=8

# TMDB v3 API key or v4 read token for the movie/series availability watchlist.
# Stored as a secret by the web settings and deliberately omitted from exports.
H0MELAB_TMDB_API_KEY=

# Number of availability checks per day. 1 = every 24 hours, 24 = hourly.
# Changes apply to the next scheduled run, never a check already in progress.
H0MELAB_UPCOMING_CHECKS_PER_DAY=1

# Override the Kinox domain, e.g. when the default one is blocked for you.
# Leave empty to use kinox.to.
H0MELAB_KINOX_DOMAIN=

# Pick a random anime instead of the one you pass in.
# 0 = off, 1 = on
H0MELAB_RANDOM_ANIME=0

# Prefer serienstream.to for interactive search() by default.
# 1 = serienstream.to, 0 = aniworld.to
H0MELAB_USE_STO_SEARCH=0

# Enable AniSkip (auto skip intro/outro) if skip times are available.
# 0 = off, 1 = on
H0MELAB_ANISKIP=0

# Sites on the home page. Switching one off takes its tab away along with the
# rows it fills there; nothing already downloaded is touched. At least one site
# has to stay on. The three below this block start off and say why.
# 0 = off, 1 = on
H0MELAB_ENABLE_ANIWORLD=1
H0MELAB_ENABLE_STO=1
H0MELAB_ENABLE_MEGAKINO=1
H0MELAB_ENABLE_MOFLIX=1
# Cineby has shut down. Disabled by default.
H0MELAB_ENABLE_CINEBY=0
H0MELAB_ENABLE_FILMPALAST=1
H0MELAB_ENABLE_MANGAFIRE=1

# Enable hanime.tv support (adult content).
# 0 = off, 1 = on
H0MELAB_ENABLE_HTV=0

# Enable the Library tab in the Web UI (browse and delete downloaded files).
# 0 = off, 1 = on
H0MELAB_ENABLE_LIBRARY=1

# Enable Auto-Sync. On a schedule it checks only the AniWorld/SerienStream
# series explicitly added on the Auto-Sync page.
# It queues what is missing for each selected language and destination. Off by
# default because it downloads on its own. The schedule is set further down.
# 0 = off, 1 = on
H0MELAB_ENABLE_AUTOSYNC=0

# Auto-Sync: queue only episodes/language releases first seen after a series was
# added instead of filling every existing gap for that series.
# 0 = off (fill the gaps), 1 = on (only the new ones)
H0MELAB_AUTOSYNC_NEW_ONLY=0

# How Auto-Sync decides when to run.
# interval = every so often, see H0MELAB_AUTOSYNC_INTERVAL
# cron     = at fixed times, see H0MELAB_AUTOSYNC_CRON
# Options: interval | cron
H0MELAB_AUTOSYNC_MODE=interval

# Time between two runs in interval mode, counted from the last run.
# Examples: 24h | 6h | 90m | 1h30m | 2d (a bare number means hours).
# Five minutes is the shortest it will take.
H0MELAB_AUTOSYNC_INTERVAL=24h

# Fixed times in cron mode: minute hour day-of-month month day-of-week.
# Plain language is accepted too and is stored as cron:
#   every day at 10pm             -> 0 22 * * *
#   every monday, friday at 8am   -> 0 8 * * 1,5
#   weekdays at 07:30             -> 30 7 * * 1,2,3,4,5
#   every 6 hours                 -> 0 */6 * * *
# Times are the local time of the machine. Cron cannot put 08:00 and 22:30 on
# one line, so several schedules can be separated by ";" and all of them run.
H0MELAB_AUTOSYNC_CRON="0 3 * * *"

# Enable the BurningSeries tab.
# Disabled by default: BurningSeries is behind a geo-block and additionally
# protected by Google reCAPTCHA, which we currently have no way to bypass.
# Turn this on only if you can reach it yourself (e.g. correct region / VPN).
# 0 = off, 1 = on
H0MELAB_ENABLE_BURNINGSERIES=0

# Enable the Kinox tab.
# Disabled by default: Kinox demands a captcha for every download, which we
# currently have no way to bypass automatically.
# 0 = off, 1 = on
H0MELAB_ENABLE_KINOX=0


# ==============================
# Captcha Solver Settings
# ==============================
# Fine-tuning for the Cloudflare Turnstile captcha solver (playwright/captcha.py).
# All of these are optional — the defaults already work for most setups.

# Never auto-click a captcha widget - only your own click in the Web UI counts.
# 0 = off (auto-solve), 1 = on (manual only)
H0MELAB_CAPTCHA_MANUAL=0

# Show the captcha browser window instead of pushing it off-screen.
# 0 = off (hidden), 1 = on (visible)
H0MELAB_CAPTCHA_VISIBLE=0

# Solve timeout in seconds. Leave empty to use the built-in default
# (300s for the standalone solver, 90s for the serienstream.to modal flow).
H0MELAB_CAPTCHA_TIMEOUT=

# Resolve configured SerienStream domains over Cloudflare DoH, with Google as
# fallback, and pass short-lived exact-host mappings to Chromium. No system DNS
# changes; other browser domains keep their normal resolver. 0 disables this.
H0MELAB_STO_BROWSER_DNS=1

# Disable the network ad-blocker used during captcha solving.
# Try turning this on if a captcha page won't load.
# 0 = adblock on, 1 = adblock off
H0MELAB_NO_ADBLOCK=0

# Log the captcha browser's console/network errors to the app log — useful
# when a captcha keeps failing and you need to see what's actually happening
# in the browser without opening DevTools yourself (which can trigger a
# Cloudflare Turnstile bot-detection error as a side effect).
# 0 = off, 1 = on
H0MELAB_CAPTCHA_DEBUG_LOG=0

# Disable auto-closing of pop-up ad tabs opened during the serienstream.to modal flow.
# 0 = guard on, 1 = guard off
H0MELAB_CAPTCHA_NO_ADTAB_GUARD=0

# Disable removal of invisible full-page ad-overlay links that can hijack clicks.
# 0 = removal on, 1 = removal off
H0MELAB_CAPTCHA_NO_OVERLAY_REMOVAL=0

# Disable syncing the HTTP session's User-Agent to the solving browser's real UA.
# 0 = sync on, 1 = sync off
H0MELAB_CAPTCHA_NO_UA_SYNC=0

# Spoof the WebGL renderer string (Intel/Mesa) to mask SwiftShader on GPU-less
# servers/Docker. Usually not needed - leave off unless you're troubleshooting.
# 0 = off, 1 = on
H0MELAB_SPOOF_WEBGL=0

# Force a persistent Chromium profile (keeps a warm cf_clearance cookie across
# solves) even outside Docker, where it is off by default.
# 0 = off, 1 = on
H0MELAB_PERSISTENT_PROFILE=0

# Force a fresh (non-persistent) browser profile every solve, even inside
# Docker, where persistence is normally on by default.
# 0 = off, 1 = on
H0MELAB_NO_PERSISTENT_PROFILE=0

# Custom directory for the persistent Chromium profile.
# Leave empty to use the default: ~/.h0melab-downloader/browser-profile
H0MELAB_BROWSER_PROFILE=

# Manually flag the process as running in Docker (normally auto-detected via
# /.dockerenv). Affects the persistent-profile default and a few launch args.
# 0 = off, 1 = on
H0MELAB_DOCKER=0


# ==============================
# Player Integration
# ==============================

# Which player Syncplay should use.
# 0 = mpv (cross-platform)
# 1 = IINA (macOS only; requires IINA installed)
H0MELAB_USE_IINA=1


# ==============================
# Syncplay Settings (auto-generated if left empty)
# ==============================

# Syncplay server host:port
# Default: syncplay.pl:8998
# Other ports: syncplay.pl:8995 / :8996 / :8997 / :8999
H0MELAB_SYNCPLAY_HOST=

# Room to join.
# If H0MELAB_SYNCPLAY_ROOM is empty, the app generates it from the episode name:
# - If H0MELAB_SYNCPLAY_PASSWORD is NOT set:
#     AniWorld-Highschool_DxD_S01E01
# - If H0MELAB_SYNCPLAY_PASSWORD IS set (example: "beans"), the room becomes a SHA256 hash:
#     plain: AniWorld-Highschool_DxD_S01E01-beans
#     room:  AniWorld-53de358cf5b5fe716f78747bad1c874ed23147509bbaf540d02aac31f4f35656
#
# Tip: setting H0MELAB_SYNCPLAY_PASSWORD changes the generated room name, so only people with the same
# password end up in the same room (unless you manually set H0MELAB_SYNCPLAY_ROOM).
H0MELAB_SYNCPLAY_ROOM=

# Your name shown in Syncplay.
# If empty, it will use your system username.
# Example: phoenixthrush
H0MELAB_SYNCPLAY_USERNAME=

# Optional. Used only when H0MELAB_SYNCPLAY_ROOM is empty (see above).
# Setting this WILL change the generated room name.
H0MELAB_SYNCPLAY_PASSWORD=


# ==============================
# Web UI Authentication
# ==============================

# Enable authentication for the browser UI.
# 0 = off, 1 = on
H0MELAB_WEB_AUTH=0
H0MELAB_WEB_SSO=0
H0MELAB_WEB_FORCE_SSO=0

# Set both to auto-create an admin on first run (skips the setup page).
H0MELAB_WEB_ADMIN_USER=
H0MELAB_WEB_ADMIN_PASS=


# Public base URL when behind a reverse proxy (e.g. https://example.com).
# Leave empty when not using a reverse proxy.
H0MELAB_WEB_BASE_URL=


# ==============================
# OIDC Single Sign-On (optional)
# ==============================

# Required when SSO or force-SSO is enabled.
H0MELAB_OIDC_ISSUER_URL=
H0MELAB_OIDC_CLIENT_ID=
H0MELAB_OIDC_CLIENT_SECRET=
H0MELAB_OIDC_DISPLAY_NAME=SSO

# In force-SSO mode, this SSO username is auto-promoted to admin.
# Using H0MELAB_OIDC_ADMIN_SUBJECT is preferred !!!
H0MELAB_OIDC_ADMIN_USER=

# SSO subject (sub claim) for the admin user - more secure than username matching.
# If set, this takes precedence over H0MELAB_OIDC_ADMIN_USER for admin promotion.
# Tip: the subject is logged on every SSO login - check the server logs to find it.
# In Keycloak: Admin Console -> Users -> click user -> the "ID" field is the sub claim.
H0MELAB_OIDC_ADMIN_SUBJECT=


# ==============================
# FFmpeg & Encoding Settings
# ==============================

# Video codec behavior.
# copy = no re-encode (fastest, keeps original)
# h264 / h265 / av1 = re-encode using FFmpeg (slower, smaller files depending on settings)
# h264_nvenc / hevc_nvenc = NVIDIA GPU encoding (requires a compatible GPU, driver, and NVENC-enabled FFmpeg)
# h264_amf / hevc_amf / av1_amf = AMD GPU encoding (requires a GPU supporting the chosen codec, AMF runtime/driver, and AMF-enabled FFmpeg)
# h264_qsv / hevc_qsv / av1_qsv = Intel GPU encoding (requires a compatible GPU/IGPU, driver, and QSV-enabled FFmpeg)
H0MELAB_VIDEO_CODEC=copy


# ==============================
# Discord Request Bot (optional)
# ==============================

# Let users request movies and series from Discord.
# 0 = off, 1 = on
H0MELAB_DISCORD_BOT_ENABLED=0

# Bot token from https://discord.com/developers/applications
H0MELAB_DISCORD_TOKEN=

# Your Discord user ID. Requests are sent here for approval.
H0MELAB_DISCORD_OWNER_ID=

# standard  = every request needs your approval via DM
# advanced  = requests are queued immediately
H0MELAB_DISCORD_MODE=standard

# Only members with this role may request. Leave empty to allow everyone.
H0MELAB_DISCORD_REQUEST_ROLE_ID=

# Register the slash commands in this server only (instant).
# Leave empty to register globally (can take up to an hour to appear).
H0MELAB_DISCORD_GUILD_ID=

# Bot language: command names, descriptions and messages.
# Options: en | de
H0MELAB_DISCORD_LANGUAGE=en

# Optional channel ID. When a requested download finishes, a "now available"
# message is posted here (the requester is always DM'd regardless).
H0MELAB_DISCORD_ANNOUNCE_CHANNEL_ID=
